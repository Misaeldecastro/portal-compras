# Config do app Web do Firebase (projeto prj-prd-infra-01).
# Obtenha com: firebase apps:sdkconfig web --project prj-prd-infra-01
# No CI, estes mesmos valores são secrets do GitHub.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloud Functions ---
# SLACK_BOT_TOKEN vive no Secret Manager, não em arquivo:
#   gcloud secrets create SLACK_BOT_TOKEN --data-file=- --project=prj-prd-infra-01
# Só é necessário aqui para rodar o emulador local.
SLACK_BOT_TOKEN=

# Opcional. O padrão é https://compras-oliv-e.web.app (functions/api/http.js).
PORTAL_URL=

# Opcional — fallback caso não haja aprovador/comprador cadastrado por e-mail no Firestore
SLACK_APROVADOR_USER_ID=
SLACK_COMPRADOR_USER_ID=

# Opcional — sobrescreve o banco nomeado usado pelas functions (padrão: portal-compras)
FIRESTORE_DATABASE_ID=
